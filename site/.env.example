# Leave unset to browse the bundled, source-attributed research archive.
# A real Sanity project is required to activate its published collection.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set only in deployment/server runtime for confidential editorial features.
# Never commit private dataset tokens.
SANITY_API_READ_TOKEN=
