{
  "name": "darb1718-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:media": "node scripts/prepare-media.mjs",
    "predev": "npm run prepare:media",
    "dev": "next dev",
    "prebuild": "npm run prepare:media && npm run check:content",
    "build": "next build",
    "start": "next start",
    "check:content": "node scripts/check-content.mjs && node --test tests/content.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "next-sanity": "^13.1.5",
    "sanity": "^5.29.0",
    "gsap": "^3.14.0",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "@playwright/test": "^1.64.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
